@using ShopView.Areas.Admin.Models
@model FoodIndexViewModel

<style>
    body {
        background: #f5f7fb;
    }

    .page-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .page-title h2 {
            font-weight: 800;
            margin: 0;
            color: #111827;
        }

    .modern-card {
        background: #fff;
        border-radius: 22px;
        padding: 25px;
        box-shadow: 0 10px 40px rgba(0,0,0,.06);
        border: none;
    }

    .filter-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 25px;
        color: #111827;
    }

    .form-label {
        font-weight: 600;
        color: #6b7280;
    }

    .form-control,
    .form-select {
        height: 50px;
        border-radius: 14px;
        border: 1px solid #e5e7eb;
        box-shadow: none !important;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #696cff;
        }

    .btn-create {
        background: linear-gradient(135deg,#696cff,#5f61e6);
        border: none;
        border-radius: 14px;
        padding: 12px 22px;
        font-weight: 600;
        color: white;
        transition: .3s;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 10px 20px rgba(105,108,255,.3);
        }

    .btn-filter {
        background: linear-gradient(135deg,#696cff,#5f61e6);
        border: none;
        border-radius: 12px;
        padding: 12px 28px;
        color: white;
        font-weight: 600;
    }

    .btn-reset {
        border-radius: 12px;
        padding: 12px 28px;
        font-weight: 600;
    }

    .table-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,.06);
    }

    .table-header {
        padding: 25px;
        border-bottom: 1px solid #f1f1f1;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .table-header h4 {
            margin: 0;
            font-weight: 700;
        }

    .modern-table {
        margin: 0;
    }

        .modern-table thead {
            background: #f9fafb;
        }

        .modern-table th {
            padding: 18px;
            border: none;
            color: #6b7280;
            font-size: 14px;
            font-weight: 700;
        }

        .modern-table td {
            padding: 18px;
            vertical-align: middle;
            border-top: 1px solid #f3f4f6;
        }

    .food-img {
        width: 65px;
        height: 65px;
        object-fit: cover;
        border-radius: 16px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

    .food-name {
        font-weight: 700;
        color: #111827;
    }

    .food-price {
        font-weight: 700;
        color: #10b981;
    }

    .badge-modern-success {
        background: rgba(16,185,129,.12);
        color: #10b981;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .badge-modern-danger {
        background: rgba(239,68,68,.12);
        color: #ef4444;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .dropdown-toggle::after {
        display: none;
    }

    .dropdown-menu {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.1);
        padding: 10px;
    }

    .dropdown-item {
        border-radius: 10px;
        padding: 10px 14px;
        transition: .2s;
    }

        .dropdown-item:hover {
            background: #f3f4f6;
        }

    .pagination {
        margin-top: 30px;
    }

    .page-link {
        border: none;
        margin: 0 5px;
        border-radius: 12px !important;
        color: #111827;
        padding: 12px 18px;
        font-weight: 600;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
    }

    .page-item.active .page-link {
        background: linear-gradient(135deg,#696cff,#5f61e6);
        color: white;
    }

    .alert {
        border: none;
        border-radius: 16px;
        padding: 18px;
        font-weight: 600;
    }

    @@media(max-width:768px) {

        .page-title {
            flex-direction: column;
            gap: 15px;
            align-items: flex-start;
        }

        .modern-table {
            min-width: 900px;
        }
    }
</style>

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- PAGE TITLE -->
    <div class="page-title">

        <div>
            <h2>Food Management</h2>
            <p class="text-muted mb-0">
                Manage your restaurant foods professionally
            </p>
        </div>

        <a href="/Admin/Food/Create" class="btn btn-create">
            <i class="bx bx-plus"></i>
            Create New Food
        </a>

    </div>

    <!-- ALERT -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- FILTER -->
    <div class="modern-card mb-4">

        <div class="filter-title">
            Filter Foods
        </div>

        <form method="get" asp-action="Index">

            <div class="row">

                <div class="col-lg-6 mb-4">
                    <label class="form-label">
                        Search Food
                    </label>

                    <input type="text"
                           name="keyword"
                           class="form-control"
                           placeholder="Search by name or description..."
                           value="@Model.Filter.Keyword" />
                </div>

                <div class="col-lg-6 mb-4">
                    <label class="form-label">
                        Price Range
                    </label>

                    <div class="input-group">

                        <input type="number"
                               name="priceFrom"
                               class="form-control"
                               placeholder="Min"
                               value="@Model.Filter.PriceFrom" />

                        <span class="input-group-text bg-white border-0">
                            →
                        </span>

                        <input type="number"
                               name="priceTo"
                               class="form-control"
                               placeholder="Max"
                               value="@Model.Filter.PriceTo" />

                    </div>
                </div>

                <div class="col-lg-4 mb-4">
                    <label class="form-label">
                        Category
                    </label>

                    @Html.DropDownList(
                             "categoryId",
                             new SelectList(Model.Categories, "Value", "Text", Model.Filter.categoryID),
                             "All Categories",
                             new { @class = "form-select" })
                </div>

                <div class="col-lg-4 mb-4">
                    <label class="form-label">
                        Sort By
                    </label>

                    @Html.DropDownList(
                             "sortBy",
                             new List<SelectListItem>
                    {
                    new SelectListItem { Value = "Name", Text = "Name" },
                    new SelectListItem { Value = "Price", Text = "Price" }
                    },
                             "Select",
                             new { @class = "form-select" })
                </div>

                <div class="col-lg-4 mb-4">
                    <label class="form-label">
                        Sort Order
                    </label>

                    @Html.DropDownList(
                             "sortOrder",
                             new List<SelectListItem>
                    {
                    new SelectListItem { Value = "asc", Text = "Ascending" },
                    new SelectListItem { Value = "desc", Text = "Descending" }
                    },
                             "Select",
                             new { @class = "form-select" })
                </div>

            </div>

            <div class="text-center">

                <button type="submit" class="btn btn-filter me-2">
                    <i class="bx bx-filter-alt"></i>
                    Apply Filters
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary btn-reset">
                    Reset
                </a>

            </div>

        </form>

    </div>

    <!-- TABLE -->
    <div class="table-card">

        <div class="table-header">
            <h4>Food List</h4>
        </div>

        <div class="table-responsive">

            <table class="table modern-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Food</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.PagedResult.Data != null)
                    {
                        @foreach (var food in Model.PagedResult.Data)
                        {
                            <tr>

                                <td>
                                    #@food.FoodItemID
                                </td>

                                <td>

                                    <div class="d-flex align-items-center">

                                        @if (!string.IsNullOrEmpty(food.ImagePath))
                                        {
                                            <img src="@(Model.ImageBaseUrl + food.ImagePath)"
                                                 class="food-img me-3" />
                                        }
                                        else
                                        {
                                            <img src="https://via.placeholder.com/100x100?text=Food"
                                                 class="food-img me-3" />
                                        }

                                        <div>
                                            <div class="food-name">
                                                @food.Name
                                            </div>

                                            <small class="text-muted">
                                                Delicious restaurant food
                                            </small>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @food.CategoryName
                                </td>

                                <td class="food-price">
                                    @food.Price.ToString("N0") VND
                                </td>

                                <td>

                                    @if (food.IsAvailable)
                                    {
                                        <span class="badge-modern-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-modern-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <div class="dropdown">

                                        <button class="btn btn-light rounded-pill"
                                                data-bs-toggle="dropdown">

                                            <i class="bx bx-dots-vertical-rounded"></i>

                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end">

                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@food.FoodItemID">

                                                <i class="bx bx-edit-alt me-2"></i>
                                                Edit

                                            </a>

                                            @if (food.IsAvailable)
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="Food"
                                                      asp-action="Deactive"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@food.FoodItemID" />

                                                    <button type="submit"
                                                            class="dropdown-item text-danger"
                                                            onclick="return confirm('Deactivate this food?');">

                                                        <i class="bx bx-trash me-2"></i>
                                                        Deactivate

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="Food"
                                                      asp-action="Active"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@food.FoodItemID" />

                                                    <button type="submit"
                                                            class="dropdown-item text-success"
                                                            onclick="return confirm('Activate this food?');">

                                                        <i class="bx bx-check-circle me-2"></i>
                                                        Activate

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- PAGINATION -->
    @if (Model.PagedResult.TotalPages > 1)
    {
        <nav>

            <ul class="pagination justify-content-center">

                @for (int i = 1; i <= Model.PagedResult.TotalPages; i++)
                {
                    <li class="page-item @(Model.PagedResult.CurrentPage == i ? "active" : "")">

                        <a class="page-link"
                           href="@Url.Action("Index", "Food", new
                           {
                               page = i,
                               keyword = Model.Filter.Keyword,
                               categoryId = Model.Filter.categoryID,
                               priceFrom = Model.Filter.PriceFrom,
                               priceTo = Model.Filter.PriceTo,
                               sortBy = Model.Filter.SortBy,
                               sortOrder = Model.Filter.SortOrder
                           })">

                            @i

                        </a>

                    </li>
                }

            </ul>

        </nav>
    }

</div>
```
