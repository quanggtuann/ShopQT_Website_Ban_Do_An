@using ShopView.Areas.Admin.Models
@model AccountIndexViewModel

<style>

    body {
        background: #f4f7fb;
    }

    .admin-page {
        max-width: 1600px;
        margin: auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }

        .page-header h2 {
            font-size: 38px;
            font-weight: 900;
            color: #111827;
            margin: 0;
        }

        .page-header p {
            margin-top: 6px;
            color: #6b7280;
            font-size: 15px;
        }

    .btn-create {
        background: linear-gradient(135deg,#696cff,#5f61e6);
        border: none;
        color: white;
        border-radius: 16px;
        padding: 14px 24px;
        font-weight: 700;
        transition: .25s;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 10px 25px rgba(105,108,255,.25);
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 20px;
        margin-bottom: 28px;
    }

    .stats-card {
        background: white;
        border-radius: 24px;
        padding: 24px;
        box-shadow: 0 10px 35px rgba(0,0,0,.05);
    }

    .stats-title {
        color: #6b7280;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .stats-value {
        font-size: 32px;
        font-weight: 900;
        color: #111827;
    }

    .filter-card,
    .table-card {
        background: white;
        border-radius: 28px;
        box-shadow: 0 10px 40px rgba(0,0,0,.05);
        border: none;
    }

    .filter-card {
        padding: 30px;
        margin-bottom: 28px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 25px;
        color: #111827;
    }

    .modern-label {
        font-weight: 700;
        margin-bottom: 10px;
        color: #4b5563;
    }

    .modern-input,
    .modern-select {
        border-radius: 16px !important;
        border: 1px solid #e5e7eb !important;
        min-height: 52px;
        box-shadow: none !important;
        padding: 12px 16px !important;
    }

        .modern-input:focus,
        .modern-select:focus {
            border-color: #696cff !important;
            box-shadow: 0 0 0 4px rgba(105,108,255,.12) !important;
        }

    .btn-filter {
        background: linear-gradient(135deg,#696cff,#5f61e6);
        border: none;
        color: white;
        border-radius: 14px;
        padding: 12px 24px;
        font-weight: 700;
    }

    .btn-reset {
        border-radius: 14px;
        padding: 12px 24px;
        font-weight: 700;
    }

    .table-header {
        padding: 24px 30px;
        border-bottom: 1px solid #f1f5f9;
    }

        .table-header h4 {
            margin: 0;
            font-size: 22px;
            font-weight: 800;
        }

    .admin-table {
        margin: 0;
    }

        .admin-table thead {
            background: #f8fafc;
        }

        .admin-table th {
            border: none;
            padding: 20px;
            font-size: 13px;
            font-weight: 800;
            color: #6b7280;
        }

        .admin-table td {
            padding: 20px;
            vertical-align: middle;
            border-top: 1px solid #f1f5f9;
        }

    .table-row {
        transition: .2s;
    }

        .table-row:hover {
            background: #fafcff;
        }

    .user-name {
        font-weight: 800;
        color: #111827;
    }

    .user-email {
        color: #6b7280;
        font-size: 14px;
    }

    .badge-role-admin {
        background: rgba(105,108,255,.12);
        color: #696cff;
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 12px;
    }

    .badge-role-customer {
        background: rgba(14,165,233,.12);
        color: #0ea5e9;
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 12px;
    }

    .badge-active {
        background: rgba(16,185,129,.12);
        color: #10b981;
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 12px;
    }

    .badge-inactive {
        background: rgba(239,68,68,.12);
        color: #ef4444;
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 12px;
    }

    .action-btn {
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 14px;
        background: #f3f4f6;
        transition: .2s;
    }

        .action-btn:hover {
            background: #696cff;
            color: white;
        }

    .dropdown-menu {
        border: none;
        border-radius: 18px;
        padding: 10px;
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
    }

    .dropdown-item {
        border-radius: 12px;
        padding: 12px 14px;
        font-weight: 600;
    }

        .dropdown-item:hover {
            background: #f3f4f6;
        }

    .pagination {
        padding: 30px 0;
    }

    .page-link {
        border: none;
        margin: 0 5px;
        border-radius: 12px !important;
        padding: 10px 16px;
        font-weight: 700;
        color: #111827;
        box-shadow: 0 5px 15px rgba(0,0,0,.05);
    }

    .page-item.active .page-link {
        background: linear-gradient(135deg,#696cff,#5f61e6);
        color: white;
    }

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

        .empty-state i {
            font-size: 70px;
            color: #d1d5db;
            margin-bottom: 20px;
        }

        .empty-state h5 {
            font-weight: 800;
            color: #111827;
        }

        .empty-state p {
            color: #6b7280;
        }
</style>

<div class="container-xxl py-4 admin-page">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <h2>Accounts Management</h2>
            <p>Manage system accounts professionally and efficiently</p>
        </div>

        <a href="/Admin/Account/Create" class="btn btn-create">
            <i class="bx bx-plus me-2"></i>
            Create New User
        </a>

    </div>

    <!-- ALERT -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm border-0">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm border-0">
            @TempData["ErrorMessage"]
        </div>
    }
        <div class="stats-card">
            <div class="stats-title">Active Users</div>
            <div class="stats-value">
                @Model.PagedResult.Data.Count(x => x.IsActive)
            </div>
        </div>

        <div class="stats-card">
            <div class="stats-title">Inactive Users</div>
            <div class="stats-value">
                @Model.PagedResult.Data.Count(x => !x.IsActive)
            </div>
        </div>

    </div>

    <!-- FILTER -->
    <div class="filter-card">

        <div class="section-title">
            Filter Accounts
        </div>

        <form method="get"
              asp-area="Admin"
              asp-controller="Account"
              asp-action="Index">

            <div class="row">

                <div class="col-lg-6 mb-4">
                    <label class="modern-label">
                        Search
                    </label>

                    <input type="text"
                           name="keyword"
                           class="form-control modern-input"
                           placeholder="Username, email, phone..."
                           value="@Model.Filter.Keyword" />
                </div>

                <div class="col-lg-3 mb-4">
                    <label class="modern-label">
                        Role
                    </label>

                    <select name="role"
                            class="form-select modern-select">

                        <option value="">
                            All Roles
                        </option>

                        <option value="admin"
                                selected="@(Model.Filter.Role == "admin")">

                            Admin

                        </option>

                        <option value="customer"
                                selected="@(Model.Filter.Role == "customer")">

                            Customer

                        </option>

                    </select>
                </div>

                <div class="col-lg-3 mb-4">
                    <label class="modern-label">
                        Status
                    </label>

                    <select name="isActive"
                            class="form-select modern-select">

                        <option value="">
                            All Status
                        </option>

                        <option value="true"
                                selected="@(Model.Filter.IsActive == true)">

                            Active

                        </option>

                        <option value="false"
                                selected="@(Model.Filter.IsActive == false)">

                            Inactive

                        </option>

                    </select>
                </div>

            </div>

            <div class="row">

                <div class="col-lg-3 mb-4">
                    <label class="modern-label">
                        Sort By
                    </label>

                    <select name="sortBy"
                            class="form-select modern-select">

                        <option value="id">ID</option>
                        <option value="username">Username</option>
                        <option value="email">Email</option>
                        <option value="role">Role</option>
                        <option value="status">Status</option>

                    </select>
                </div>

                <div class="col-lg-3 mb-4">
                    <label class="modern-label">
                        Sort Order
                    </label>

                    <select name="sortOrder"
                            class="form-select modern-select">

                        <option value="asc">Ascending</option>
                        <option value="desc">Descending</option>

                    </select>
                </div>

            </div>

            <div class="text-end">

                <button type="submit"
                        class="btn btn-filter me-2">

                    <i class="bx bx-filter-alt me-1"></i>
                    Apply Filters

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary btn-reset">

                    Reset

                </a>

            </div>

        </form>

    </div>

    <!-- TABLE -->
    <div class="table-card">

        <div class="table-header">
            <h4>Account List</h4>
        </div>

        <div class="table-responsive">

            <table class="table admin-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>USER</th>
                        <th>ROLE</th>
                        <th>STATUS</th>
                        <th class="text-center">ACTIONS</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.PagedResult?.Data != null &&
                    Model.PagedResult.Data.Any())
                    {
                        @foreach (var account in Model.PagedResult.Data)
                        {
                            <tr class="table-row">

                                <td>
                                    #@account.UserID
                                </td>

                                <td>

                                    <div class="user-name">
                                        @account.Username
                                    </div>

                                    <div class="user-email">
                                        @account.Email
                                    </div>

                                </td>

                                <td>

                                    @if (account.Role == "admin")
                                    {
                                        <span class="badge-role-admin">
                                            ADMIN
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-role-customer">
                                            CUSTOMER
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (account.IsActive)
                                    {
                                        <span class="badge-active">
                                            ACTIVE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">
                                            INACTIVE
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <div class="dropdown">

                                        <button type="button"
                                                class="action-btn"
                                                data-bs-toggle="dropdown">

                                            <i class="bx bx-dots-vertical-rounded"></i>

                                        </button>

                                        <div class="dropdown-menu dropdown-menu-end">

                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@account.UserID">

                                                <i class="bx bx-edit-alt me-2"></i>
                                                Edit

                                            </a>

                                            @if (account.IsActive)
                                            {
                                                <form asp-action="Deactivate"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@account.UserID" />

                                                    <button type="submit"
                                                            class="dropdown-item text-danger">

                                                        <i class="bx bx-trash me-2"></i>
                                                        Deactivate

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activate"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@account.UserID" />

                                                    <button type="submit"
                                                            class="dropdown-item text-success">

                                                        <i class="bx bx-check-circle me-2"></i>
                                                        Activate

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">

                                <div class="empty-state">

                                    <i class="bx bx-user-x"></i>

                                    <h5>No Accounts Found</h5>

                                    <p>
                                        There are currently no accounts available.
                                    </p>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGINATION -->
        @if (Model.PagedResult.TotalPages > 1)
        {
            <nav>

                <ul class="pagination justify-content-center">

                    @for (int i = 1; i <= Model.PagedResult.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PagedResult.CurrentPage ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i">

                                @i

                            </a>

                        </li>
                    }

                </ul>

            </nav>
        }

    </div>

</div>