@using ShopView.Areas.Admin.Models
@model ComboCreateViewModel

<style>

    body {
        background: #f5f7ff;
    }

    .create-page {
        max-width: 1500px;
        margin: auto;
    }

    .page-header {
        margin-bottom: 32px;
    }

    .page-title {
        font-size: 40px;
        font-weight: 900;
        color: #111827;
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 15px;
    }

    .modern-card {
        background: white;
        border-radius: 32px;
        border: none;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.06);
    }

    .card-header-modern {
        padding: 30px 35px;
        border-bottom: 1px solid #f1f5f9;
        background: white;
    }

        .card-header-modern h4 {
            margin: 0;
            font-size: 28px;
            font-weight: 900;
            color: #111827;
        }

    .card-body-modern {
        padding: 35px;
    }

    .modern-label {
        font-weight: 800;
        color: #374151;
        margin-bottom: 10px;
        display: block;
    }

    .modern-input,
    .modern-textarea {
        border-radius: 18px !important;
        border: 1px solid #e5e7eb !important;
        padding: 16px 18px !important;
        min-height: 58px;
        box-shadow: none !important;
        transition: .25s;
        font-size: 15px;
    }

    .modern-textarea {
        min-height: 130px;
        resize: none;
    }

        .modern-input:focus,
        .modern-textarea:focus {
            border-color: #696cff !important;
            box-shadow: 0 0 0 4px rgba(105,108,255,.12) !important;
        }

    .food-wrapper {
        border: 1px solid #eef2f7;
        border-radius: 24px;
        overflow: hidden;
        background: #fbfcff;
    }

    .food-table {
        margin: 0;
    }

        .food-table thead {
            background: #f8fafc;
        }

        .food-table th {
            padding: 18px;
            border: none;
            font-size: 13px;
            font-weight: 900;
            color: #6b7280;
            text-transform: uppercase;
        }

        .food-table td {
            padding: 18px;
            vertical-align: middle;
            border-top: 1px solid #eef2f7;
        }

    .food-row {
        transition: .2s;
    }

        .food-row:hover {
            background: #f9fbff;
        }

    .food-image {
        width: 55px;
        height: 55px;
        object-fit: cover;
        border-radius: 16px;
        box-shadow: 0 8px 18px rgba(0,0,0,.08);
    }

    .food-name {
        font-weight: 800;
        color: #111827;
        font-size: 15px;
    }

    .quantity-input {
        width: 90px;
        border-radius: 14px !important;
        border: 1px solid #dbe2ea !important;
        text-align: center;
        font-weight: 700;
        padding: 10px;
    }

    .image-upload {
        border: 2px dashed #dbe2ea;
        border-radius: 24px;
        padding: 30px;
        text-align: center;
        background: #fafcff;
        transition: .25s;
    }

        .image-upload:hover {
            border-color: #696cff;
            background: #f5f7ff;
        }

    .status-wrapper {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .status-card {
        flex: 1;
        min-width: 220px;
        border: 2px solid #eef2f7;
        border-radius: 22px;
        padding: 22px;
        cursor: pointer;
        transition: .25s;
        background: white;
    }

        .status-card:hover {
            border-color: #696cff;
            transform: translateY(-2px);
        }

        .status-card input {
            transform: scale(1.2);
        }

    .status-title {
        font-weight: 800;
        color: #111827;
        margin-bottom: 4px;
    }

    .status-desc {
        color: #6b7280;
        font-size: 14px;
    }

    .btn-create {
        background: linear-gradient(135deg,#696cff,#5f61e6);
        border: none;
        color: white;
        padding: 15px 30px;
        border-radius: 18px;
        font-weight: 800;
        box-shadow: 0 12px 25px rgba(105,108,255,.25);
        transition: .25s;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            color: white;
        }

    .btn-cancel {
        border-radius: 18px;
        padding: 15px 30px;
        font-weight: 800;
    }

    .alert {
        border: none;
        border-radius: 20px;
        padding: 18px 22px;
        font-weight: 700;
    }

    @@media(max-width:992px) {

        .food-table {
            min-width: 800px;
        }

        .card-body-modern {
            padding: 24px;
        }

        .page-title {
            font-size: 32px;
        }
    }

</style>

<div class="container-xxl py-4 create-page">

    <!-- HEADER -->
    <div class="page-header">

        <div class="page-title">
            Create Combo
        </div>

        <div class="page-subtitle">
            Create beautiful restaurant combos with food items and pricing
        </div>

    </div>

    <!-- ALERT -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4">
            @TempData["Error"]
        </div>
    }

    <!-- CARD -->
    <div class="modern-card">

        <div class="card-header-modern">

            <h4>
                New Combo Information
            </h4>

        </div>

        <div class="card-body-modern">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div class="row">

                    <!-- LEFT -->
                    <div class="col-lg-7">

                        <!-- NAME -->
                        <div class="mb-4">

                            <label class="modern-label">
                                Combo Name *
                            </label>

                            <input type="text"
                                   name="Name"
                                   class="form-control modern-input"
                                   required
                                   placeholder="Enter combo name..."
                                   value="@Model.Combo.Name" />

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="mb-4">

                            <label class="modern-label">
                                Description
                            </label>

                            <textarea name="Description"
                                      class="form-control modern-textarea"
                                      placeholder="Write combo description...">@Model.Combo.Description</textarea>

                        </div>

                        <!-- PRICE -->
                        <div class="mb-4">

                            <label class="modern-label">
                                Combo Price *
                            </label>

                            <input type="number"
                                   name="Price"
                                   step="0.01"
                                   required
                                   class="form-control modern-input"
                                   placeholder="Enter combo price..."
                                   value="@Model.Combo.Price" />

                        </div>

                    </div>

                    <!-- RIGHT -->
                    <div class="col-lg-5">

                        <!-- IMAGE -->
                        <div class="mb-4">

                            <label class="modern-label">
                                Upload Image
                            </label>

                            <div class="image-upload">

                                <i class="bx bx-image-add"
                                   style="font-size:55px;color:#696cff;"></i>

                                <div class="fw-bold mt-3 mb-2">
                                    Upload Combo Image
                                </div>

                                <div class="text-muted small mb-3">
                                    PNG, JPG or WEBP
                                </div>

                                <input type="file"
                                       name="imageFile"
                                       class="form-control modern-input"
                                       accept="image/*" />

                            </div>

                        </div>

                        <!-- STATUS -->
                        <div class="mb-4">

                            <label class="modern-label">
                                Status
                            </label>

                            <div class="status-wrapper">

                                <label class="status-card">

                                    <div class="d-flex align-items-start gap-3">

                                        <input type="radio"
                                               name="IsAvailable"
                                               value="true"
                                               checked
                                               class="form-check-input mt-1" />

                                        <div>

                                            <div class="status-title">
                                                Active
                                            </div>

                                            <div class="status-desc">
                                                Combo will be available for customers
                                            </div>

                                        </div>

                                    </div>

                                </label>

                                <label class="status-card">

                                    <div class="d-flex align-items-start gap-3">

                                        <input type="radio"
                                               name="IsAvailable"
                                               value="false"
                                               class="form-check-input mt-1" />

                                        <div>

                                            <div class="status-title">
                                                Inactive
                                            </div>

                                            <div class="status-desc">
                                                Combo will be hidden temporarily
                                            </div>

                                        </div>

                                    </div>

                                </label>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- FOOD ITEMS -->
                <div class="mt-2">

                    <label class="modern-label mb-3">
                        Select Food Items
                    </label>

                    @if (Model.AvailableFoods != null && Model.AvailableFoods.Any())
                    {
                        <div class="food-wrapper">

                            <div class="table-responsive"
                                 style="max-height:500px;overflow-y:auto;">

                                <table class="table food-table">

                                    <thead>

                                        <tr>

                                            <th style="width:80px;">
                                                Select
                                            </th>

                                            <th>
                                                Food Item
                                            </th>

                                            <th style="width:140px;">
                                                Quantity
                                            </th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        @for (int i = 0; i < Model.AvailableFoods.Count; i++)
                                        {
                                            var food = Model.AvailableFoods[i];

                                            <tr class="food-row">

                                                <td>

                                                    <input type="checkbox"
                                                           name="FoodItems[@i].FoodItemId"
                                                           value="@food.FoodItemId"
                                                           class="form-check-input"
                                                           style="transform:scale(1.3);" />

                                                </td>

                                                <td>

                                                    <div class="d-flex align-items-center gap-3">

                                                        @if (!string.IsNullOrEmpty(food.ImagePath))
                                                        {
                                                            <img src="@(Model.ImageBaseUrl + food.ImagePath)"
                                                                 class="food-image" />
                                                        }
                                                        else
                                                        {
                                                            <img src="https://via.placeholder.com/100x100?text=Food"
                                                                 class="food-image" />
                                                        }

                                                        <div>

                                                            <div class="food-name">
                                                                @food.Name
                                                            </div>

                                                            <small class="text-muted">
                                                                Food Item
                                                            </small>

                                                        </div>

                                                    </div>

                                                </td>

                                                <td>

                                                    <input type="number"
                                                           name="FoodItems[@i].Quantity"
                                                           value="1"
                                                           min="1"
                                                           class="form-control quantity-input" />

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-3">
                            No food items available. Please create food items first.
                        </div>
                    }

                </div>

                <!-- BUTTONS -->
                <div class="d-flex justify-content-end gap-3 mt-5">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary btn-cancel">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-create">

                        <i class="bx bx-save me-2"></i>
                        Create Combo

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>