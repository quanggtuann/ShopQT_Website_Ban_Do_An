@model ShopView.ViewModels.ComboViewModels

@{
    Layout = "_MyLayout";
    ViewData["Title"] = "Combo Menu";
}

<section class="py-5">
    <div class="container">

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger rounded-4 mb-4">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- HEADER -->
        <div class="text-center mb-5">

            <h1 class="fw-bold display-4 text-dark mb-3">
                🍔 Combo Menu
            </h1>

            <p class="text-muted fs-5">
                Discover delicious combo meals with amazing prices
            </p>

        </div>

        <!-- FILTER -->
        <div class="card border-0 shadow-lg rounded-4 mb-5 filter-card">

            <div class="card-body p-4">

                <div class="mb-4">
                    <h2 class="fw-bold text-dark mb-1">
                        Find Your Favorite Combo
                    </h2>

                    <p class="text-muted mb-0">
                        Search, filter and sort delicious meals
                    </p>
                </div>

                <form method="get">

                    <div class="row g-3 align-items-end">

                        <!-- SEARCH -->
                        <div class="col-xl-4 col-lg-6">

                            <label class="form-label fw-semibold">
                                Search Combo
                            </label>

                            <div class="input-group search-group">

                                <span class="input-group-text bg-white border-end-0">
                                    🔍
                                </span>

                                <input type="text"
                                       name="Keyword"
                                       value="@Model.Filter.Keyword"
                                       class="form-control border-start-0 shadow-none"
                                       placeholder="Search combo..." />

                            </div>

                        </div>

                        <!-- PRICE FROM -->
                        <div class="col-xl-2 col-lg-3 col-md-6">

                            <label class="form-label fw-semibold">
                                From Price
                            </label>

                            <input type="number"
                                   name="PriceFrom"
                                   value="@Model.Filter.PriceFrom"
                                   class="form-control shadow-none"
                                   placeholder="$0" />

                        </div>

                        <!-- PRICE TO -->
                        <div class="col-xl-2 col-lg-3 col-md-6">

                            <label class="form-label fw-semibold">
                                To Price
                            </label>

                            <input type="number"
                                   name="PriceTo"
                                   value="@Model.Filter.PriceTo"
                                   class="form-control shadow-none"
                                   placeholder="$100" />

                        </div>

                        <!-- SORT BY -->
                        <div class="col-xl-2 col-lg-3 col-md-6">

                            <label class="form-label fw-semibold">
                                Sort By
                            </label>

                            <select name="SortBy"
                                    class="form-select shadow-none">

                                <option value="name"
                                        selected="@(Model.Filter.SortBy == "name")">
                                    Name
                                </option>

                                <option value="price"
                                        selected="@(Model.Filter.SortBy == "price")">
                                    Price
                                </option>

                            </select>

                        </div>

                        <!-- ORDER -->
                        <div class="col-xl-2 col-lg-3 col-md-6">

                            <label class="form-label fw-semibold">
                                Order
                            </label>

                            <select name="SortOrder"
                                    class="form-select shadow-none">

                                <option value="asc"
                                        selected="@(Model.Filter.SortOrder == "asc")">
                                    Ascending
                                </option>

                                <option value="desc"
                                        selected="@(Model.Filter.SortOrder == "desc")">
                                    Descending
                                </option>

                            </select>

                        </div>

                    </div>

                    <!-- BUTTON -->
                    <div class="mt-4 text-end">

                        <button type="submit"
                                class="btn btn-danger px-5 py-3 rounded-pill fw-bold shadow-sm">

                            Apply Filter

                        </button>

                    </div>

                </form>

            </div>

        </div>

        <!-- COMBO LIST -->
        <div class="row g-4">

            @if (Model.PagedResult.Data != null && Model.PagedResult.Data.Any())
            {
                @foreach (var item in Model.PagedResult.Data)
                {
                    <div class="col-xl-4 col-md-6">

                        <div class="card combo-card border-0 shadow-sm h-100">

                            <!-- IMAGE -->
                            <div class="combo-image-wrapper">

                                <img src="@(string.IsNullOrWhiteSpace(item.ImagePath)
                                        ? "https://via.placeholder.com/600x400?text=Combo"
                                        : Model.ImageBaseUrl.TrimEnd('/') + "/" + item.ImagePath.TrimStart('/'))"
                                     class="combo-image"
                                     alt="@item.Name" />

                                <div class="combo-overlay">

                                    <a asp-action="Details"
                                       asp-route-id="@item.ComboId"
                                       class="btn btn-light rounded-pill fw-bold px-4">

                                        View Detail

                                    </a>

                                </div>

                            </div>

                            <!-- BODY -->
                            <div class="card-body d-flex flex-column p-4">

                                <div class="mb-3">

                                    <span class="badge bg-danger px-3 py-2 rounded-pill">
                                        Combo Meal
                                    </span>

                                </div>

                                <h3 class="fw-bold text-dark mb-3">
                                    @item.Name
                                </h3>

                                <p class="text-muted flex-grow-1">

                                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "No description available"
                                        : item.Description)

                                </p>

                                <div class="d-flex justify-content-between align-items-center mt-4">

                                    <div>

                                        <small class="text-muted">
                                            Price
                                        </small>

                                        <h2 class="text-danger fw-bold mb-0">
                                            $@item.Price
                                        </h2>

                                    </div>

                                    <a asp-action="Details"
                                       asp-route-id="@item.ComboId"
                                       class="btn btn-dark rounded-pill px-4">

                                        Order Now

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="alert alert-warning text-center rounded-4 p-5 shadow-sm">

                        <h2 class="fw-bold">
                            😢 No Combo Found
                        </h2>

                        <p class="mb-0 mt-3">
                            Please try another keyword or filter.
                        </p>

                    </div>

                </div>
            }

        </div>

        <!-- PAGINATION -->
        @if (Model.PagedResult.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-5">

                <nav>

                    <ul class="pagination pagination-lg">

                        <!-- PREVIOUS -->
                        <li class="page-item @(Model.PagedResult.CurrentPage == 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.PagedResult.CurrentPage - 1)"
                               asp-route-pageSize="@Model.Filter.pageSize"
                               asp-route-Keyword="@Model.Filter.Keyword"
                               asp-route-PriceFrom="@Model.Filter.PriceFrom"
                               asp-route-PriceTo="@Model.Filter.PriceTo"
                               asp-route-SortBy="@Model.Filter.SortBy"
                               asp-route-SortOrder="@Model.Filter.SortOrder">

                                Previous

                            </a>

                        </li>

                        <!-- PAGE NUMBER -->
                        @for (int i = 1; i <= Model.PagedResult.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PagedResult.CurrentPage ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@Model.Filter.pageSize"
                                   asp-route-Keyword="@Model.Filter.Keyword"
                                   asp-route-PriceFrom="@Model.Filter.PriceFrom"
                                   asp-route-PriceTo="@Model.Filter.PriceTo"
                                   asp-route-SortBy="@Model.Filter.SortBy"
                                   asp-route-SortOrder="@Model.Filter.SortOrder">

                                    @i

                                </a>

                            </li>
                        }

                        <!-- NEXT -->
                        <li class="page-item @(Model.PagedResult.CurrentPage == Model.PagedResult.TotalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.PagedResult.CurrentPage + 1)"
                               asp-route-pageSize="@Model.Filter.pageSize"
                               asp-route-Keyword="@Model.Filter.Keyword"
                               asp-route-PriceFrom="@Model.Filter.PriceFrom"
                               asp-route-PriceTo="@Model.Filter.PriceTo"
                               asp-route-SortBy="@Model.Filter.SortBy"
                               asp-route-SortOrder="@Model.Filter.SortOrder">

                                Next

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>
</section>

<style>

    body {
        background: #f5f7fb;
    }

    .filter-card {
        border-radius: 24px;
        background: #fff;
    }

    .form-control,
    .form-select,
    .input-group-text {
        height: 54px;
        border-radius: 14px;
        border: 1px solid #dee2e6;
    }

    .input-group .form-control {
        border-left: 0;
    }

    .input-group-text {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 56px;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.15rem rgba(220,53,69,.15);
    }

    .combo-card {
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.35s ease;
        background: white;
    }

        .combo-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 45px rgba(0,0,0,0.15);
        }

    .combo-image-wrapper {
        position: relative;
        height: 260px;
        overflow: hidden;
    }

    .combo-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.5s;
    }

    .combo-card:hover .combo-image {
        transform: scale(1.08);
    }

    .combo-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: 0.35s;
    }

    .combo-card:hover .combo-overlay {
        opacity: 1;
    }

    .page-link {
        color: #dc3545;
        border-radius: 12px !important;
        margin: 0 4px;
        border: none;
        padding: 12px 18px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

        .page-link:hover {
            background: #dc3545;
            color: white;
        }

    .page-item.active .page-link {
        background: #dc3545;
        color: white;
    }

    @@media (max-width: 991px) {

        .text-end {
            text-align: center !important;
        }

        .btn-danger {
            width: 100%;
        }
    }

</style>