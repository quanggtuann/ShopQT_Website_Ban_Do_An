@using Microsoft.Extensions.Localization
@model ShopAPI.DTOs.ComboDto
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["ComboDetail"];

    var imageBaseUrl = ViewBag.ImageBaseUrl as string ?? "https://localhost:7130/";
}

<style>
    body {
        background: #f4f7fb;
    }

    .combo-detail-page {
        padding: 80px 0;
    }

    .combo-card {
        background: white;
        border-radius: 36px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,.08);
    }

    .combo-image-wrapper {
        position: relative;
        height: 100%;
        overflow: hidden;
    }

    .combo-image {
        width: 100%;
        height: 100%;
        min-height: 620px;
        object-fit: cover;
    }

    .combo-content {
        padding: 55px;
    }

    .combo-badge {
        display: inline-block;
        background: rgba(220,53,69,.12);
        color: #dc3545;
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 22px;
    }

    .combo-title {
        font-size: 48px;
        font-weight: 900;
        color: #111827;
        margin-bottom: 18px;
        line-height: 1.2;
    }

    .combo-price {
        font-size: 42px;
        font-weight: 900;
        color: #dc3545;
        margin-bottom: 30px;
    }

    .combo-description {
        color: #6b7280;
        font-size: 16px;
        line-height: 1.9;
        margin-bottom: 35px;
    }

    .food-list-box {
        background: #f8fafc;
        border-radius: 24px;
        padding: 24px;
        margin-bottom: 35px;
    }

    .food-list-item {
        display: flex;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .food-list-item:last-child {
            border-bottom: none;
        }

    .combo-actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .btn-back {
        background: #fee2e2;
        color: #dc3545;
        border: none;
        border-radius: 18px;
        padding: 16px 28px;
        font-weight: 800;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #dc3545;
            color: white;
        }

    .btn-order {
        background: linear-gradient(135deg,#dc3545,#b02a37);
        border: none;
        color: white;
        border-radius: 18px;
        padding: 16px 34px;
        font-weight: 800;
        text-decoration: none;
    }

        .btn-order:hover {
            color: white;
        }

    @@media (max-width: 992px) {
        .combo-content {
            padding: 35px;
        }

        .combo-title {
            font-size: 36px;
        }

        .combo-image {
            min-height: 400px;
        }
    }
</style>

<div class="container combo-detail-page">
    <div class="combo-card">
        <div class="row g-0">
            <div class="col-lg-6">
                <div class="combo-image-wrapper">
                    <img src="@(string.IsNullOrWhiteSpace(Model.ImagePath)
                            ? "https://via.placeholder.com/900x700?text=Combo+Image"
                            : imageBaseUrl.TrimEnd('/') + "/" + Model.ImagePath.TrimStart('/'))"
                         class="combo-image"
                         alt="@Model.Name" />
                </div>
            </div>

            <div class="col-lg-6">
                <div class="combo-content">
                    <div class="combo-badge">@Localizer["ComboMeal"]</div>

                    <h1 class="combo-title">@Model.Name</h1>

                    @if (Model.HasDiscount)
                    {
                        <div class="text-muted text-decoration-line-through fs-5">
                            @String.Format("{0:N0} \u20AB", Model.OriginalPrice)
                        </div>
                        <div class="badge rounded-pill bg-danger px-3 py-2 mb-2">
                            @Model.DiscountCampaignName
                        </div>
                    }

                    <div class="combo-price">@String.Format("{0:N0} \u20AB", Model.Price)</div>

                    <div class="combo-description">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? Localizer["NoDescriptionCombo"]
                            : Model.Description)
                    </div>

                    @if (Model.FoodItems != null && Model.FoodItems.Any())
                    {
                        <div class="food-list-box">
                            <h5 class="fw-bold mb-3">@Localizer["IncludedItems"]</h5>
                            @foreach (var food in Model.FoodItems)
                            {
                                <div class="food-list-item">
                                    <span>@food.FoodName</span>
                                    <span class="fw-bold">x @food.Quantity</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="combo-actions">
                        <a asp-controller="Combo" asp-action="Index" class="btn btn-back">
                            @Localizer["BackToMenu"]
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Cart"
                               asp-action="AddCombo"
                               asp-route-id="@Model.ComboId"
                               asp-route-returnUrl="@Context.Request.Path"
                               class="btn btn-order">
                                @Localizer["OrderNow"]
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               asp-route-returnUrl="@Url.Action("Details", "Combo", new { id = Model.ComboId })"
                               class="btn btn-order">
                                @Localizer["LoginToOrder"]
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




