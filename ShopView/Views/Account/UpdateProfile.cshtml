@using Microsoft.Extensions.Localization
@model ShopView.ViewModels.UpdateProfile
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["EditProfile"];
    ViewData["PageClass"] = "account-context";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-pages.css" asp-append-version="true" />
}

<main class="account-page account-form-page container">
    <header class="account-header">
        <div>
            <span class="account-eyebrow">@Localizer["Profile"]</span>
            <h1>@Localizer["EditProfile"]</h1>
            <p>@Localizer["UpdatePersonalInformation"]</p>
        </div>
        <a asp-action="Profile" class="account-outline-action">
            <i class="fa fa-arrow-left" aria-hidden="true"></i> @Localizer["BackToProfile"]
        </a>
    </header>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="account-alert account-alert-error" role="alert">@TempData["ErrorMessage"]</div>
    }

    <form asp-action="UpdateProfile" method="post" class="account-card account-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="account-alert account-alert-error"></div>
        <div class="account-card-heading"><h2>@Localizer["PersonalInformation"]</h2></div>

        <div class="account-form-grid">
            <div class="account-field">
                <label asp-for="Email">@Localizer["EmailAddress"]</label>
                <input asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="account-validation"></span>
            </div>
            <div class="account-field">
                <label asp-for="PhoneNumber">@Localizer["PhoneNumber"]</label>
                <input asp-for="PhoneNumber" type="tel" autocomplete="tel" inputmode="numeric"
                       maxlength="10" pattern="0[0-9]{9}" />
                <span asp-validation-for="PhoneNumber" class="account-validation"></span>
            </div>
            <div class="account-field">
                <label asp-for="DateorBirth">@Localizer["DateOfBirth"]</label>
                <input asp-for="DateorBirth" type="date" />
                <span asp-validation-for="DateorBirth" class="account-validation"></span>
            </div>
        </div>

        <div class="account-form-actions">
            <a asp-action="Profile" class="account-text-action">@Localizer["Cancel"]</a>
            <button type="submit" class="account-primary-action">@Localizer["SaveChanges"]</button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
