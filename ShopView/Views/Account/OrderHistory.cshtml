@using Microsoft.Extensions.Localization
@using System.Globalization
@model ShopView.ViewModels.PagedResponse<ShopView.ViewModels.CustomerOrderViewModel>
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["OrderHistory"];
    ViewData["PageClass"] = "account-context";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var currentReturnUrl = $"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}";
    var pageSizeValue = ViewContext.HttpContext.Request.Query["pageSize"].ToString();
    if (string.IsNullOrWhiteSpace(pageSizeValue)) pageSizeValue = "6";
    var orders = Model?.Data ?? new List<ShopView.ViewModels.CustomerOrderViewModel>();
    var cancelReasons = new[]
    {
        Localizer["CancelReasonChangedMind"].Value,
        Localizer["CancelReasonWrongDetails"].Value,
        Localizer["CancelReasonChangeItems"].Value,
        Localizer["CancelReasonBetterPrice"].Value,
        Localizer["CancelReasonDeliveryTime"].Value,
        Localizer["CancelReasonDuplicate"].Value
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-pages.css" asp-append-version="true" />
}

<main class="account-page container">
    <header class="account-header">
        <div>
            <span class="account-eyebrow">@Localizer["Orders"]</span>
            <h1>@Localizer["OrderHistory"]</h1>
            <p>@Localizer["OrderHistorySubtitle"]</p>
        </div>
        <a asp-controller="Food" asp-action="Index" class="account-outline-action">
            @Localizer["ContinueShopping"] <i class="fa fa-arrow-right" aria-hidden="true"></i>
        </a>
    </header>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="account-alert account-alert-error" role="alert">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="account-alert account-alert-success" role="status">@TempData["SuccessMessage"]</div>
    }

    @if (orders.Count == 0)
    {
        <section class="account-empty" aria-labelledby="orders-empty-title">
            <span class="account-empty-icon" aria-hidden="true"><i class="fa fa-receipt"></i></span>
            <h2 id="orders-empty-title">@Localizer["NoOrdersYet"]</h2>
            <p>@Localizer["NoOrdersHint"]</p>
            <a asp-controller="Food" asp-action="Index" class="account-primary-action">@Localizer["BrowseNow"]</a>
        </section>
    }
    else
    {
        <div class="order-history-list">
            @foreach (var order in orders)
            {
                <article class="account-card order-list-card">
                    <div class="order-list-top">
                        <div>
                            <h2>@Localizer["OrderNumber"] #@order.OrderId</h2>
                            <p>@order.OrderTime.ToString("dd/MM/yyyy · HH:mm") · @order.Items.Count @Localizer["Items"]</p>
                        </div>
                        <span class="order-status status-@order.Status.ToLowerInvariant()">@Localizer[order.Status]</span>
                    </div>

                    <div class="order-list-details">
                        <div>
                            <span>@Localizer["DeliveryAddress"]</span>
                            <strong>@order.ShippingAddress</strong>
                        </div>
                        <div>
                            <span>@Localizer["GrandTotal"]</span>
                            <strong class="order-list-total">@order.TotalAmount.ToString("N0", vi) ₫</strong>
                        </div>
                    </div>

                    <div class="order-list-actions">
                        <a asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId"
                           class="account-secondary-action">@Localizer["ViewDetails"] <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
                        @if (order.CanCancel)
                        {
                            <details class="order-cancel-details">
                                <summary class="account-danger-link">@Localizer["CancelOrder"]</summary>
                                <form asp-controller="Order" asp-action="Cancel" method="post" class="order-cancel-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.OrderId" />
                                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                    <label for="reason-@order.OrderId">@Localizer["CancelReasonLabel"]</label>
                                    <select id="reason-@order.OrderId" name="cancelReason" required>
                                        <option value="">@Localizer["SelectCancelReason"]</option>
                                        @foreach (var reason in cancelReasons)
                                        {
                                            <option value="@reason">@reason</option>
                                        }
                                        <option value="Other">@Localizer["CancelReasonOther"]</option>
                                    </select>
                                    <textarea name="cancelReasonDetail" rows="3" hidden
                                              placeholder="@Localizer["CancelReasonDetailHint"]"></textarea>
                                    <button type="submit" class="account-delete-action">@Localizer["ConfirmCancelOrder"]</button>
                                </form>
                            </details>
                        }
                    </div>

                    @if (string.Equals(order.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)
                         && !string.IsNullOrWhiteSpace(order.CancelReason))
                    {
                        <div class="order-cancelled-note">
                            <strong>@Localizer["CancellationReason"]</strong>
                            <span>@order.CancelReason</span>
                            @if (!string.IsNullOrWhiteSpace(order.CancelReasonDetail))
                            {
                                <p>@order.CancelReasonDetail</p>
                            }
                        </div>
                    }
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="account-pagination" aria-label="Pagination">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a asp-action="OrderHistory" asp-route-page="@pageNumber" asp-route-pageSize="@pageSizeValue"
                       class="@(pageNumber == Model.CurrentPage ? "is-current" : "")"
                       aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                }
            </nav>
        }
    }
</main>

@section Scripts {
    <script>
        document.querySelectorAll('.order-cancel-form').forEach(form => {
            const reason = form.querySelector('select[name="cancelReason"]');
            const detail = form.querySelector('textarea[name="cancelReasonDetail"]');
            reason.addEventListener('change', () => {
                const isOther = reason.value === 'Other';
                detail.hidden = !isOther;
                detail.required = isOther;
                if (!isOther) detail.value = '';
            });
        });
    </script>
}
