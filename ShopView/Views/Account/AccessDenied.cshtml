@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AccessDenied"];
    Layout = "~/Views/Shared/_MyLayout.cshtml";
}

<div class="container py-5 text-center">
    <h2 class="text-danger mb-3">@Localizer["AccessDenied"]</h2>
    <p class="mb-4">@Localizer["AccessDeniedMessage"]</p>
    <a asp-controller="Food" asp-action="Index" class="btn btn-primary">@Localizer["BackToHome"]</a>
    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary ms-2">@Localizer["Login"]</a>
</div>


