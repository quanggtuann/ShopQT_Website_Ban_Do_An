@using Microsoft.Extensions.Localization
@model ShopView.ViewModels.ChangePasswordViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["ChangePassword"];
    ViewData["PageClass"] = "account-context";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-pages.css" asp-append-version="true" />
}

<main class="account-page account-form-page container">
    <header class="account-header">
        <div>
            <span class="account-eyebrow">@Localizer["Profile"]</span>
            <h1>@Localizer["ChangePassword"]</h1>
            <p>@Localizer["KeepAccountSecure"]</p>
        </div>
        <a asp-action="Profile" class="account-outline-action">
            <i class="fa fa-arrow-left" aria-hidden="true"></i> @Localizer["BackToProfile"]
        </a>
    </header>

    <form asp-action="ChangePassword" method="post" class="account-card account-form account-password-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="account-alert account-alert-error"></div>
        <div class="account-card-heading"><h2>@Localizer["ChangePassword"]</h2></div>

        <div class="account-field">
            <label asp-for="CurrentPassword">@Localizer["CurrentPassword"]</label>
            <div class="account-password-input">
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password"
                       placeholder="@Localizer["EnterCurrentPassword"]" />
                <button type="button" class="account-password-toggle" data-target="CurrentPassword"
                        aria-label="@Localizer["ShowPassword"]" aria-pressed="false">
                    <i class="fa fa-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="CurrentPassword" class="account-validation"></span>
        </div>

        <div class="account-field">
            <label asp-for="NewPassword">@Localizer["NewPassword"]</label>
            <div class="account-password-input">
                <input asp-for="NewPassword" type="password" autocomplete="new-password"
                       minlength="7"
                       placeholder="@Localizer["EnterNewPassword"]" />
                <button type="button" class="account-password-toggle" data-target="NewPassword"
                        aria-label="@Localizer["ShowPassword"]" aria-pressed="false">
                    <i class="fa fa-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="account-validation"></span>
        </div>

        <div class="account-field">
            <label asp-for="ConfirmPassword">@Localizer["ConfirmPassword"]</label>
            <div class="account-password-input">
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                       placeholder="@Localizer["ConfirmNewPassword"]" />
                <button type="button" class="account-password-toggle" data-target="ConfirmPassword"
                        aria-label="@Localizer["ShowPassword"]" aria-pressed="false">
                    <i class="fa fa-eye" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="account-validation"></span>
        </div>

        <p class="account-form-note"><i class="fa fa-info-circle" aria-hidden="true"></i> @Localizer["ConfirmChangePasswordNotice"]</p>

        <div class="account-form-actions">
            <a asp-action="Profile" class="account-text-action">@Localizer["Cancel"]</a>
            <button type="submit" class="account-primary-action">@Localizer["SaveChanges"]</button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const showPasswordLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ShowPassword"].Value));
        const hidePasswordLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["HidePassword"].Value));

        document.querySelectorAll('.account-password-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.target);
                const visible = input.type === 'password';
                input.type = visible ? 'text' : 'password';
                button.setAttribute('aria-pressed', String(visible));
                button.setAttribute('aria-label', visible ? hidePasswordLabel : showPasswordLabel);
                button.querySelector('i').className = visible ? 'fa fa-eye-slash' : 'fa fa-eye';
            });
        });
    </script>
}
