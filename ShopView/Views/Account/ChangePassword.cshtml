@using Microsoft.Extensions.Localization
@model ShopView.ViewModels.ChangePasswordViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["ChangePassword"];
}

<div class="change-password-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-6">

                <div class="password-card">

                    <div class="password-header">

                        <div class="lock-icon">
                            🔒
                        </div>

                        <h2>
                            @Localizer["ChangePassword"]
                        </h2>

                        <p>
                            @Localizer["KeepAccountSecure"]
                        </p>

                    </div>

                    <div class="password-body">

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success rounded-pill">
                                @TempData["SuccessMessage"]
                            </div>
                        }

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <form method="post" id="changePasswordForm">
                            <div class="mb-4">

                                <label asp-for="CurrentPassword"
                                       class="form-label">

                                    @Localizer["CurrentPassword"]

                                </label>

                                <div class="password-wrapper">

                                    <input asp-for="CurrentPassword"
                                           type="password"
                                           class="form-control custom-input password-field"
                                           placeholder='@Localizer["EnterCurrentPassword"]' />

                                    <span class="toggle-password">
                                        👁
                                    </span>

                                </div>

                                <span asp-validation-for="CurrentPassword"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="mb-4">

                                <label asp-for="NewPassword"
                                       class="form-label">

                                    @Localizer["NewPassword"]

                                </label>

                                <div class="password-wrapper">

                                    <input asp-for="NewPassword"
                                           type="password"
                                           class="form-control custom-input password-field"
                                           placeholder='@Localizer["EnterNewPassword"]' />

                                    <span class="toggle-password">
                                        👁
                                    </span>

                                </div>

                                <span asp-validation-for="NewPassword"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="mb-4">

                                <label asp-for="ConfirmPassword"
                                       class="form-label">

                                    @Localizer["ConfirmPassword"]

                                </label>

                                <div class="password-wrapper">

                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           class="form-control custom-input password-field"
                                           placeholder='@Localizer["ConfirmNewPassword"]' />

                                    <span class="toggle-password">
                                        👁
                                    </span>

                                </div>

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="d-flex gap-3">

                                <button type="button"
                                        class="btn-save"
                                        data-toggle="modal"
                                        data-target="#confirmChangePasswordModal">
                                    @Localizer["SaveChanges"]
                                </button>

                                <a asp-action="Profile"
                                   class="btn-cancel">

                                    @Localizer["Back"]

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .change-password-page {
        padding: 60px 0;
    }

    .password-card {
        background: white;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.08);
        animation: cardShow .6s ease;
    }

    .password-header {
        text-align: center;
        padding: 40px;
        background: linear-gradient(135deg,#ff9f43,#ff6b35);
        color: white;
    }

    .lock-icon {
        width: 90px;
        height: 90px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 40px;
        margin-bottom: 20px;
    }

    .password-header h2 {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .password-body {
        padding: 40px;
    }

    .form-label {
        font-weight: 700;
        margin-bottom: 10px;
    }

    .custom-input {
        height: 55px;
        border-radius: 15px;
        padding-right: 50px;
    }

        .custom-input:focus {
            border-color: #ff6b35;
            box-shadow: 0 0 0 .2rem rgba(255,107,53,.15);
        }

    .password-wrapper {
        position: relative;
    }

    .toggle-password {
        position: absolute;
        right: 18px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        font-size: 18px;
    }

    .btn-save {
        border: none;
        background: linear-gradient(135deg,#ff9f43,#ff6b35);
        color: white;
        padding: 12px 30px;
        border-radius: 50px;
        font-weight: 700;
        transition: .3s;
    }

        .btn-save:hover {
            transform: translateY(-2px);
        }

    .btn-cancel {
        padding: 12px 30px;
        border-radius: 50px;
        border: 2px solid #ddd;
        color: #555;
        text-decoration: none;
        font-weight: 700;
    }

        .btn-cancel:hover {
            text-decoration: none;
            color: #222;
        }

    @@keyframes cardShow {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .confirm-modal {
        border-radius: 25px;
        border: none;
        backdrop-filter: blur(10px);
        animation: pop .25s ease;
    }

    .confirm-icon {
        width: 80px;
        height: 80px;
        margin: auto;
        border-radius: 50%;
        background: linear-gradient(135deg,#ff9f43,#ff6b35);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: white;
        box-shadow: 0 10px 30px rgba(255,107,53,.3);
    }

    @@keyframes pop {
        from

    {
        transform: scale(.8);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }

    }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
    }

    .btn-danger:hover {
        transform: translateY(-2px);
    }
        </style>

<script>

    document.querySelectorAll('.toggle-password').forEach(btn => {

        btn.addEventListener('click', function () {

            const input = this.parentElement.querySelector('input');

            input.type =
                input.type === 'password'
                ? 'text'
                : 'password';

        });

    });

</script>
<div class="modal fade" id="confirmChangePasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal">

            <div class="modal-body text-center p-5">

                <div class="confirm-icon">
                    ⚠️
                </div>

                <h4 class="mt-3 fw-bold">
                    @Localizer["ConfirmPasswordChange"]
                </h4>

                <p class="text-muted">
                    @Localizer["ConfirmChangePasswordQuestion"]<br />
                    @Localizer["ConfirmChangePasswordNotice"]
                </p>

                <div class="d-flex justify-content-center mt-4">

                    <button type="button"
                            class="btn btn-outline-secondary px-4 rounded-pill mr-2"
                            data-dismiss="modal">
                        @Localizer["NoCancel"]
                    </button>

                    <button type="submit"
                            form="changePasswordForm"
                            class="btn btn-danger px-4 rounded-pill">
                        @Localizer["YesChange"]
                    </button>

                </div>

            </div>

        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

