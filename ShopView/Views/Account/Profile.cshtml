@using Microsoft.Extensions.Localization
@model ShopView.ViewModels.CustomerProfileViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["Profile"];
    ViewData["PageClass"] = "account-context";
    var displayName = string.IsNullOrWhiteSpace(Model.Username) ? Localizer["CustomerType"].Value : Model.Username;
    var initial = displayName[..1].ToUpperInvariant();
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-pages.css" asp-append-version="true" />
}

<main class="account-page container">
    <header class="account-header">
        <div>
            <span class="account-eyebrow">@Localizer["Profile"]</span>
            <h1>@Localizer["PersonalInformation"]</h1>
            <p>@Localizer["ProfileSubtitle"]</p>
        </div>
        <a asp-action="UpdateProfile" class="account-outline-action">
            <i class="fa fa-pencil-alt" aria-hidden="true"></i> @Localizer["EditProfile"]
        </a>
    </header>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="account-alert account-alert-error" role="alert">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="account-alert account-alert-success" role="status">@TempData["SuccessMessage"]</div>
    }

    <div class="account-grid">
        <div class="account-main-column">
            <section class="account-card account-identity" aria-labelledby="identity-title">
                <span class="account-avatar" aria-hidden="true">@initial</span>
                <div>
                    <h2 id="identity-title">@displayName</h2>
                    <p>@Model.Email</p>
                    @if (Model.UserID > 0)
                    {
                        <span class="account-status @(Model.IsActive ? "is-active" : "is-inactive")">
                            <span aria-hidden="true"></span>
                            @(Model.IsActive ? Localizer["Active"] : Localizer["Inactive"])
                        </span>
                    }
                </div>
            </section>

            <section class="account-card account-info" aria-labelledby="personal-title">
                <div class="account-card-heading">
                    <h2 id="personal-title">@Localizer["PersonalInformation"]</h2>
                </div>
                <dl class="account-detail-list">
                    <div><dt>@Localizer["Username"]</dt><dd>@displayName</dd></div>
                    <div><dt>@Localizer["Email"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "—" : Model.Email)</dd></div>
                    <div><dt>@Localizer["PhoneNumber"]</dt><dd>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd></div>
                    <div><dt>@Localizer["DateOfBirth"]</dt><dd>@(Model.DateorBirth == default ? "—" : Model.DateorBirth.ToString("dd/MM/yyyy"))</dd></div>
                </dl>
            </section>
        </div>

        <aside class="account-card account-links" aria-labelledby="links-title">
            <div class="account-card-heading">
                <h2 id="links-title">@Localizer["QuickActions"]</h2>
            </div>
            <nav aria-label="@Localizer["QuickActions"]">
                <a asp-action="UpdateProfile"><i class="fa fa-user-edit" aria-hidden="true"></i><span>@Localizer["EditProfile"]</span><i class="fa fa-chevron-right" aria-hidden="true"></i></a>
                <a asp-controller="Address" asp-action="Index"><i class="fa fa-map-marker-alt" aria-hidden="true"></i><span>@Localizer["MyAddresses"]</span><i class="fa fa-chevron-right" aria-hidden="true"></i></a>
                <a asp-action="OrderHistory"><i class="fa fa-receipt" aria-hidden="true"></i><span>@Localizer["OrderHistory"]</span><i class="fa fa-chevron-right" aria-hidden="true"></i></a>
                <a asp-action="ChangePassword"><i class="fa fa-lock" aria-hidden="true"></i><span>@Localizer["ChangePassword"]</span><i class="fa fa-chevron-right" aria-hidden="true"></i></a>
            </nav>
        </aside>
    </div>
</main>
