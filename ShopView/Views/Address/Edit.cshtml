@using Microsoft.Extensions.Localization
@using ShopAPI.DTOs
@using System.Text.Json
@model ShopView.ViewModels.AddressFormViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["EditAddress"];
    ViewData["PageClass"] = "checkout-context";
    var provinces = ViewBag.Provinces as List<ProvinceDto> ?? new List<ProvinceDto>();
    var locationJson = JsonSerializer.Serialize(provinces);
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout-flow.css" asp-append-version="true" />
}

<main class="address-create-page container">
    <nav class="address-breadcrumb" aria-label="Breadcrumb">
        <a asp-action="Index">@Localizer["MyAddresses"]</a>
        <i class="fa fa-chevron-right" aria-hidden="true"></i>
        <span aria-current="page">@Localizer["EditAddress"]</span>
    </nav>

    <header class="address-create-header">
        <div>
            <h1>@Localizer["EditAddress"]</h1>
            <p>@Localizer["EditAddressSubtitle"]</p>
        </div>
        <a asp-action="Index" class="checkout-back">
            <i class="fa fa-arrow-left" aria-hidden="true"></i> @Localizer["MyAddresses"]
        </a>
    </header>

    <form asp-action="Edit" asp-route-id="@Model.AddressId" method="post" class="address-create-form">
        @Html.AntiForgeryToken()
        <input asp-for="AddressId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="flow-alert flow-alert-error"></div>

        <section class="address-form-section" aria-labelledby="receiver-title">
            <div class="address-form-section-header">
                <span class="checkout-step" aria-hidden="true">1</span>
                <div>
                    <h2 id="receiver-title">@Localizer["ReceiverInformation"]</h2>
                    <p>@Localizer["ReceiverInformationHelp"]</p>
                </div>
            </div>
            <div class="address-form-grid">
                <div class="address-field">
                    <label asp-for="ReceiverName">@Localizer["FullName"] <span aria-hidden="true">*</span></label>
                    <input asp-for="ReceiverName" autocomplete="name" />
                    <span asp-validation-for="ReceiverName" class="flow-validation"></span>
                </div>
                <div class="address-field">
                    <label asp-for="PhoneNumber">@Localizer["PhoneNumber"] <span aria-hidden="true">*</span></label>
                    <input asp-for="PhoneNumber" type="tel" autocomplete="tel" inputmode="numeric"
                           maxlength="10" pattern="0[0-9]{9}" />
                    <span asp-validation-for="PhoneNumber" class="flow-validation"></span>
                </div>
            </div>
        </section>

        <section class="address-form-section" aria-labelledby="location-title">
            <div class="address-form-section-header">
                <span class="checkout-step" aria-hidden="true">2</span>
                <div>
                    <h2 id="location-title">@Localizer["AddressInformation"]</h2>
                    <p>@Localizer["AddressInformationHelp"]</p>
                </div>
            </div>
            <div class="address-form-grid">
                <div class="address-field">
                    <label asp-for="Province">@Localizer["Province"] <span aria-hidden="true">*</span></label>
                    <select asp-for="Province" id="provinceSelect" required>
                        <option value="">@Localizer["SelectProvince"]</option>
                    </select>
                    <span asp-validation-for="Province" class="flow-validation"></span>
                </div>
                <div class="address-field">
                    <label asp-for="Ward">@Localizer["Ward"] <span aria-hidden="true">*</span></label>
                    <select asp-for="Ward" id="wardSelect" required>
                        <option value="">@Localizer["SelectWard"]</option>
                    </select>
                    <span asp-validation-for="Ward" class="flow-validation"></span>
                </div>
                <div class="address-field address-field-wide">
                    <label asp-for="DetailAddress">@Localizer["DetailAddress"] <span aria-hidden="true">*</span></label>
                    <textarea asp-for="DetailAddress" rows="3" autocomplete="street-address"
                              placeholder="@Localizer["DetailAddressPlaceholder"]"></textarea>
                    <span asp-validation-for="DetailAddress" class="flow-validation"></span>
                </div>
            </div>
        </section>

        <div class="address-form-actions">
            <a asp-action="Index" class="address-cancel">@Localizer["Cancel"]</a>
            <button type="submit" class="checkout-submit">
                @Localizer["UpdateAddress"] <i class="fa fa-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const locations = @Html.Raw(locationJson);
        const selectedProvince = @Html.Raw(JsonSerializer.Serialize(Model.Province));
        const selectedWard = @Html.Raw(JsonSerializer.Serialize(Model.Ward));
        const selectProvinceText = @Html.Raw(JsonSerializer.Serialize(Localizer["SelectProvince"].Value));
        const selectWardText = @Html.Raw(JsonSerializer.Serialize(Localizer["SelectWard"].Value));
        const provinceSelect = document.getElementById('provinceSelect');
        const wardSelect = document.getElementById('wardSelect');

        function setOptions(select, placeholder, values, selectedValue) {
            select.replaceChildren(new Option(placeholder, ''));
            [...new Set(values.filter(Boolean))].forEach(value => {
                select.add(new Option(value, value, false, value === selectedValue));
            });
            if (selectedValue && !values.includes(selectedValue)) {
                select.add(new Option(selectedValue, selectedValue, true, true));
            }
        }

        function provinceName(item) { return item.province || item.Province || ''; }
        function districts(item) { return item ? (item.districts || item.Districts || []) : []; }
        function wards(item) { return item ? (item.wards || item.Wards || []) : []; }
        function provinceWards(item) {
            const directWards = wards(item);
            return directWards.length ? directWards : districts(item).flatMap(district => wards(district));
        }
        function loadWards(selectedValue = '') {
            const province = locations.find(item => provinceName(item) === provinceSelect.value);
            setOptions(wardSelect, selectWardText, provinceWards(province), selectedValue);
        }

        provinceSelect.addEventListener('change', () => loadWards());
        setOptions(provinceSelect, selectProvinceText, locations.map(provinceName), selectedProvince);
        if (provinceSelect.value) loadWards(selectedWard);
    </script>
}
