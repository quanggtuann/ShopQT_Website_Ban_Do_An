@using Microsoft.Extensions.Localization
@model ShopView.ViewModels.AddressPageViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["MyAddresses"];
    ViewData["PageClass"] = "account-context";
    var addresses = Model?.Addresses ?? new List<ShopView.ViewModels.AddressViewModel>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-pages.css" asp-append-version="true" />
}

<main class="account-page container">
    <header class="account-header">
        <div>
            <span class="account-eyebrow">@Localizer["Profile"]</span>
            <h1>@Localizer["MyAddresses"]</h1>
            <p>@Localizer["MyAddressesDescription"]</p>
        </div>
        <a asp-action="Create" class="account-primary-action">
            <i class="fa fa-plus" aria-hidden="true"></i> @Localizer["AddAddress"]
        </a>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="account-alert account-alert-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="account-alert account-alert-error" role="alert">@TempData["ErrorMessage"]</div>
    }

    @if (addresses.Count == 0)
    {
        <section class="account-empty" aria-labelledby="address-empty-title">
            <span class="account-empty-icon" aria-hidden="true"><i class="fa fa-map-marker-alt"></i></span>
            <h2 id="address-empty-title">@Localizer["NoAddressesFound"]</h2>
            <p>@Localizer["NoAddressesHint"]</p>
            <a asp-action="Create" class="account-primary-action">@Localizer["AddFirstAddress"]</a>
        </section>
    }
    else
    {
        <div class="address-list">
            @foreach (var address in addresses)
            {
                var fullAddress = string.Join(", ", new[]
                {
                    address.DetailAddress,
                    address.Ward,
                    address.Province
                }.Where(part => !string.IsNullOrWhiteSpace(part)));

                <article class="account-card address-list-card">
                    <div class="address-list-top">
                        <div>
                            <h2>@address.ReceiverName</h2>
                            <p><i class="fa fa-phone" aria-hidden="true"></i> @address.PhoneNumber</p>
                        </div>
                        @if (address.IsDefault)
                        {
                            <span class="address-default-badge">@Localizer["Default"]</span>
                        }
                    </div>
                    <p class="address-list-location"><i class="fa fa-map-marker-alt" aria-hidden="true"></i> @fullAddress</p>
                    <div class="address-list-actions">
                        <a asp-action="Edit" asp-route-id="@address.AddressId" class="account-secondary-action">
                            <i class="fa fa-pencil-alt" aria-hidden="true"></i> @Localizer["Edit"]
                        </a>
                        @if (!address.IsDefault)
                        {
                            <form asp-action="SetDefault" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@address.AddressId" />
                                <button type="submit" class="account-secondary-action">@Localizer["SetDefault"]</button>
                            </form>
                        }
                        <button type="button" class="account-danger-link" data-toggle="modal"
                                data-target="#deleteModal_@address.AddressId">
                            <i class="fa fa-trash-alt" aria-hidden="true"></i> @Localizer["Delete"]
                        </button>
                    </div>
                </article>

                <div class="modal fade" id="deleteModal_@address.AddressId" tabindex="-1" role="dialog"
                     aria-labelledby="deleteTitle_@address.AddressId" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content account-confirm-modal">
                            <div class="modal-header">
                                <h3 class="modal-title" id="deleteTitle_@address.AddressId">@Localizer["DeleteAddress"]</h3>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            </div>
                            <div class="modal-body">
                                <p>@Localizer["DeleteAddressQuestion"]</p>
                                <small>@Localizer["CannotBeUndone"]</small>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="account-text-action" data-dismiss="modal">@Localizer["Cancel"]</button>
                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@address.AddressId" />
                                    <button type="submit" class="account-delete-action">@Localizer["YesDelete"]</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="account-pagination" aria-label="Pagination">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a asp-action="Index" asp-route-page="@pageNumber"
                       class="@(pageNumber == Model.CurrentPage ? "is-current" : "")"
                       aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                }
            </nav>
        }
    }
</main>
