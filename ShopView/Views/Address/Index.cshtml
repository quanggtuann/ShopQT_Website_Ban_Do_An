@using Microsoft.Extensions.Localization
@model ShopView.ViewModels.AddressPageViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["MyAddresses"];
}

<style>

    .page-header {
        background: linear-gradient(135deg,#dc3545,#ff6b6b);
        border-radius: 20px;
        padding: 35px;
        color: white;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(220,53,69,.2);
    }

        .page-header h2 {
            font-weight: 700;
            margin-bottom: 10px;
        }

    .btn-add-address {
        background: #ffc107;
        color: #212529;
        font-weight: 700;
        border-radius: 50px;
        padding: 12px 24px;
        transition: .3s;
        border: none;
    }

        .btn-add-address:hover {
            background: #ffca2c;
            transform: translateY(-2px);
            color: #212529;
            text-decoration: none;
        }

    .address-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        transition: all .3s ease;
        background: #fff;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
        height: 100%;
    }

        .address-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0,0,0,.12);
        }

    .default-badge {
        background: #28a745;
        color: white;
        padding: 7px 15px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
    }

    .address-name {
        font-size: 18px;
        font-weight: 700;
    }

    .address-phone {
        color: #6c757d;
        font-size: 14px;
    }

    .address-content {
        color: #555;
        line-height: 1.7;
        min-height: 60px;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .action-section {
        border-top: 1px solid #eee;
        padding-top: 15px;
        margin-top: 15px;
    }

    .btn-soft {
        border-radius: 50px;
        padding: 8px 18px;
        font-weight: 600;
    }

    .empty-box {
        background: white;
        border-radius: 24px;
        padding: 60px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,.05);
    }

    .pagination .page-link {
        border-radius: 50px;
        margin: 0 4px;
        color: #dc3545;
        border: 1px solid #dee2e6;
    }

    .pagination .active .page-link {
        background: #dc3545;
        border-color: #dc3545;
        color: white;
    }

    .alert {
        border-radius: 15px;
    }

    .modal-content {
        animation: popupShow .25s ease;
    }

    @@keyframes popupShow {
        from

    {
        transform: scale(.8);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }

    }</style>

<div class="container py-5">

    <div class="page-header d-flex justify-content-between align-items-center flex-wrap">

        <div>
            <h2>
                📍 @Localizer["MyAddresses"]
            </h2>

            <p class="mb-0">
                @Localizer["MyAddressesDescription"]
            </p>
        </div>

        <a asp-action="Create"
           class="btn-add-address">

            ➕ @Localizer["AddAddress"]

        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Addresses.Any())
    {
        <div class="empty-box">

            <h3 class="font-weight-bold mb-3">
                @Localizer["NoAddressesFound"]
            </h3>

            <p class="text-muted mb-4">
                @Localizer["AddFoodComboNow"]
            </p>

            <a asp-action="Create"
               class="btn btn-danger px-4">

                @Localizer["AddFirstAddress"]

            </a>

        </div>
    }
    else
    {

        <div class="row">

            @foreach (var address in Model.Addresses)
            {
                <div class="col-lg-6 mb-4">

                    <div class="card address-card">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between">

                                <div>

                                    <div class="address-name">
                                        @address.ReceiverName
                                    </div>

                                    <div class="address-phone">
                                        @address.PhoneNumber
                                    </div>

                                </div>

                                @if (address.IsDefault)
                                {
                                    <span class="default-badge">
                                        @Localizer["Default"]
                                    </span>
                                }

                            </div>

                            <div class="address-content mt-3">

                                @address.DetailAddress,
                                @address.Ward,
                                @address.Province

                            </div>

                            <div class="action-section">

                                <div class="d-flex flex-wrap">

                                    <a asp-action="Edit"
                                       asp-route-id="@address.AddressId"
                                       class="btn btn-outline-primary btn-soft mr-2 mb-2">

                                        ✏ @Localizer["Edit"]

                                    </a>

                                    <form asp-action="Delete"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@address.AddressId" />

                                        <button type="button"
                                                class="btn btn-outline-danger btn-soft"
                                                data-toggle="modal"
                                                data-target="#deleteModal_@address.AddressId">
                                            🗑 @Localizer["Delete"]
                                        </button>

                                    </form>                                
                                    @if (!address.IsDefault)
                                    {
                                        <form asp-action="SetDefault"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@address.AddressId" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-soft mb-2">

                                                ⭐ @Localizer["SetDefault"]

                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>
                    <div class="modal fade"
                         id="deleteModal_@address.AddressId"
                         tabindex="-1"
                         role="dialog">

                        <div class="modal-dialog modal-dialog-centered"
                             role="document">

                            <div class="modal-content border-0 shadow-lg"
                                 style="border-radius:25px;">

                                <div class="modal-body text-center p-5">

                                    <div style="
                     width:90px;
                     height:90px;
                     background:#ff8c42;
                     border-radius:50%;
                     margin:auto;
                     display:flex;
                     align-items:center;
                     justify-content:center;
                     font-size:40px;
                     color:white;">
                                        ⚠
                                    </div>

                                    <h3 class="mt-4 font-weight-bold">
                                        @Localizer["DeleteAddress"]
                                    </h3>

                                    <p class="text-muted mt-3">
                                        @Localizer["DeleteAddressQuestion"]
                                        <br />
                                        @Localizer["CannotBeUndone"]
                                    </p>

                                    <div class="mt-4">

                                        <button type="button"
                                                class="btn btn-light px-4 mr-2"
                                                data-dismiss="modal">
                                            @Localizer["Cancel"]
                                        </button>

                                        <form asp-action="Delete"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@address.AddressId" />

                                            <button type="submit"
                                                    class="btn btn-danger px-4">
                                                @Localizer["YesDelete"]
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                </div>
            }

        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">

                <ul class="pagination justify-content-center">

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i">

                                @i

                            </a>

                        </li>
                    }

                </ul>

            </nav>
        }

    }

</div>


