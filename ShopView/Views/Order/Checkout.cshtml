@using Microsoft.Extensions.Localization
@using System.Globalization
@model ShopView.ViewModels.CheckoutViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["Checkout"];
    ViewData["PageClass"] = "checkout-context";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var imageBaseUrl = "https://localhost:7130/";
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout-flow.css" asp-append-version="true" />
}

<main class="checkout-page container">
    <header class="checkout-header">
        <div>
            <span class="checkout-eyebrow">@Localizer["Checkout"]</span>
            <h1>@Localizer["ReviewAndPlaceOrder"]</h1>
            <p>@Localizer["CheckoutSubtitle"]</p>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="checkout-back">
            <i class="fa fa-arrow-left" aria-hidden="true"></i> @Localizer["BackToCart"]
        </a>
    </header>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flow-alert flow-alert-error" role="alert">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flow-alert flow-alert-success" role="status">@TempData["SuccessMessage"]</div>
    }

    <form asp-controller="Order" asp-action="Checkout" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="flow-alert flow-alert-error"></div>

        <div class="checkout-layout">
            <div class="checkout-details">
                <section class="checkout-panel" aria-labelledby="delivery-title">
                    <div class="checkout-section-header">
                        <div class="checkout-section-title">
                            <span class="checkout-step" aria-hidden="true">1</span>
                            <h2 id="delivery-title">@Localizer["DeliveryAddress"]</h2>
                        </div>
                        <a asp-controller="Address" asp-action="Create" asp-route-returnToCheckout="true" class="checkout-add-link">
                            <i class="fa fa-plus" aria-hidden="true"></i> @Localizer["AddAddress"]
                        </a>
                    </div>

                    @if (Model.Addresses.Any())
                    {
                        <div class="checkout-address-grid">
                            @foreach (var address in Model.Addresses)
                            {
                                var fullAddress = string.Join(", ", new[]
                                {
                                    address.DetailAddress,
                                    address.Ward,
                                    address.Province
                                }.Where(part => !string.IsNullOrWhiteSpace(part)));

                                <label class="checkout-choice">
                                    <input type="radio" asp-for="AddressId" value="@address.AddressId" />
                                    <span class="checkout-address-card">
                                        <span class="checkout-address-top">
                                            <strong>@address.ReceiverName</strong>
                                            @if (address.IsDefault)
                                            {
                                                <em>@Localizer["Default"]</em>
                                            }
                                        </span>
                                        <span class="checkout-address-line"><i class="fa fa-phone" aria-hidden="true"></i> @address.PhoneNumber</span>
                                        <span class="checkout-address-line"><i class="fa fa-map-marker-alt" aria-hidden="true"></i> @fullAddress</span>
                                        <span class="checkout-choice-indicator" aria-hidden="true"></span>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="checkout-no-address">@Localizer["AddDeliveryAddress"]</p>
                    }
                    <span asp-validation-for="AddressId" class="flow-validation"></span>
                </section>

                <section class="checkout-panel" aria-labelledby="payment-title">
                    <div class="checkout-section-header">
                        <div class="checkout-section-title">
                            <span class="checkout-step" aria-hidden="true">2</span>
                            <h2 id="payment-title">@Localizer["PaymentMethod"]</h2>
                        </div>
                    </div>
                    <div class="checkout-payment-grid">
                        <label class="checkout-choice">
                            <input type="radio" asp-for="PaymentMethod" value="Cash" />
                            <span class="checkout-payment-card">
                                <i class="fa fa-money-bill-wave" aria-hidden="true"></i>
                                <span><strong>@Localizer["CashOnDelivery"]</strong><small>@Localizer["PayWhenReceive"]</small></span>
                                <span class="checkout-choice-indicator" aria-hidden="true"></span>
                            </span>
                        </label>
                        <label class="checkout-choice">
                            <input type="radio" asp-for="PaymentMethod" value="VNPay" disabled="@(!Model.VnpayAvailable)" />
                            <span class="checkout-payment-card">
                                <i class="fa fa-credit-card" aria-hidden="true"></i>
                                <span><strong>VNPay</strong><small>@(Model.VnpayAvailable ? Localizer["VnpayDescription"] : Localizer["VnpayUnavailable"])</small></span>
                                <span class="checkout-choice-indicator" aria-hidden="true"></span>
                            </span>
                        </label>
                    </div>
                    <span asp-validation-for="PaymentMethod" class="flow-validation"></span>
                </section>

                <section class="checkout-panel" aria-labelledby="note-title">
                    <div class="checkout-section-header">
                        <div class="checkout-section-title">
                            <span class="checkout-step" aria-hidden="true">3</span>
                            <h2 id="note-title">@Localizer["OrderNote"]</h2>
                        </div>
                    </div>
                    <textarea asp-for="Note" class="checkout-note" rows="3"
                              placeholder="@Localizer["OrderNotePlaceholder"]"></textarea>
                </section>
            </div>

            <aside class="checkout-panel checkout-summary" aria-labelledby="summary-title">
                <h2 id="summary-title">@Localizer["OrderSummary"]</h2>
                <div class="checkout-summary-items">
                    @foreach (var item in Model.Cart.CartItems)
                    {
                        var name = item.FoodItemID.HasValue ? item.FoodItem?.Name : item.Combo?.Name;
                        var imagePath = item.FoodItemID.HasValue ? item.FoodItem?.ImagePath : item.Combo?.ImagePath;
                        var imageUrl = string.IsNullOrWhiteSpace(imagePath)
                            ? null
                            : imageBaseUrl.TrimEnd('/') + "/" + imagePath.TrimStart('/');
                        var subtotal = (item.Price ?? 0m) * item.Quantity;

                        <div class="checkout-summary-item">
                            <span class="checkout-summary-image">
                                @if (imageUrl != null)
                                {
                                    <img src="@imageUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <i class="fa fa-utensils" aria-hidden="true"></i>
                                }
                            </span>
                            <span class="checkout-summary-product">
                                <strong>@name</strong>
                                <small>@Localizer["Quantity"]: @item.Quantity</small>
                            </span>
                            <strong class="checkout-summary-price">@subtotal.ToString("N0", vi) ₫</strong>
                        </div>
                    }
                </div>
                <div class="checkout-grand-total">
                    <span>@Localizer["GrandTotal"]</span>
                    <strong>@Model.GrandTotal.ToString("N0", vi) ₫</strong>
                </div>
                <button type="submit" class="checkout-submit">
                    @Localizer["PlaceOrder"] <i class="fa fa-arrow-right" aria-hidden="true"></i>
                </button>
            </aside>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
