@using Microsoft.Extensions.Localization
@using System.Globalization
@model ShopView.ViewModels.CustomerOrderViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = $"{Localizer["OrderNumber"]} #{Model.OrderId}";
    ViewData["PageClass"] = "account-context";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var imageBaseUrl = "https://localhost:7130/";
    var currentReturnUrl = $"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}";
    var cancelReasons = new[]
    {
        Localizer["CancelReasonChangedMind"].Value,
        Localizer["CancelReasonWrongDetails"].Value,
        Localizer["CancelReasonChangeItems"].Value,
        Localizer["CancelReasonBetterPrice"].Value,
        Localizer["CancelReasonDeliveryTime"].Value,
        Localizer["CancelReasonDuplicate"].Value
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-pages.css" asp-append-version="true" />
}

<main class="account-page container">
    <header class="account-header">
        <div>
            <span class="account-eyebrow">@Localizer["OrderDetail"]</span>
            <h1>@Localizer["OrderNumber"] #@Model.OrderId</h1>
            <p>@Model.OrderTime.ToString("dd/MM/yyyy · HH:mm")</p>
        </div>
        <a asp-controller="Account" asp-action="OrderHistory" class="account-outline-action">
            <i class="fa fa-arrow-left" aria-hidden="true"></i> @Localizer["OrderHistory"]
        </a>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="account-alert account-alert-success" role="status">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="account-alert account-alert-info" role="status">@TempData["InfoMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="account-alert account-alert-error" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div class="order-detail-status-row">
        <span class="order-status status-@Model.Status.ToLowerInvariant()">@Localizer[Model.Status]</span>
        @if (Model.PaymentMethod == "VNPay" && !Model.IsPaid && Model.Status == "Pending")
        {
            <form asp-controller="Order" asp-action="PayWithVnpay" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.OrderId" />
                <button type="submit" class="account-outline-action">@Localizer["PayWithVnpay"]</button>
            </form>
        }
        @if (Model.CanCancel)
        {
            <details class="order-cancel-details">
                <summary class="account-danger-link">@Localizer["CancelOrder"]</summary>
                <form asp-controller="Order" asp-action="Cancel" method="post" class="order-cancel-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                    <label for="detail-cancel-reason">@Localizer["CancelReasonLabel"]</label>
                    <select id="detail-cancel-reason" name="cancelReason" required>
                        <option value="">@Localizer["SelectCancelReason"]</option>
                        @foreach (var reason in cancelReasons)
                        {
                            <option value="@reason">@reason</option>
                        }
                        <option value="Other">@Localizer["CancelReasonOther"]</option>
                    </select>
                    <textarea name="cancelReasonDetail" rows="3" hidden
                              placeholder="@Localizer["CancelReasonDetailHint"]"></textarea>
                    <button type="submit" class="account-delete-action">@Localizer["ConfirmCancelOrder"]</button>
                </form>
            </details>
        }
    </div>

    <div class="order-detail-layout">
        <section class="account-card order-detail-items" aria-labelledby="order-items-title">
            <div class="account-card-heading"><h2 id="order-items-title">@Localizer["OrderItems"]</h2></div>
            @foreach (var item in Model.Items)
            {
                var imageUrl = string.IsNullOrWhiteSpace(item.ImagePath)
                    ? null
                    : imageBaseUrl.TrimEnd('/') + "/" + item.ImagePath.TrimStart('/');

                <div class="order-detail-item">
                    <span class="order-detail-image">
                        @if (imageUrl != null)
                        {
                            <img src="@imageUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <i class="fa fa-utensils" aria-hidden="true"></i>
                        }
                    </span>
                    <span class="order-detail-product">
                        <strong>@item.ProductName</strong>
                        <small>@Localizer[item.ItemType] · @Localizer["Quantity"]: @item.Quantity · @item.Price.ToString("N0", vi) ₫</small>
                    </span>
                    <strong class="order-detail-price">@item.Subtotal.ToString("N0", vi) ₫</strong>
                </div>
            }
        </section>

        <aside class="account-card order-detail-info" aria-labelledby="delivery-info-title">
            <div class="account-card-heading"><h2 id="delivery-info-title">@Localizer["DeliveryInformation"]</h2></div>
            <dl class="order-detail-meta">
                <div><dt>@Localizer["Receiver"]</dt><dd>@Model.ReceiverName</dd></div>
                <div><dt>@Localizer["PhoneNumber"]</dt><dd>@Model.ReceiverPhone</dd></div>
                <div><dt>@Localizer["Address"]</dt><dd>@Model.ShippingAddress</dd></div>
                <div><dt>@Localizer["PaymentMethod"]</dt><dd>@Model.PaymentMethod</dd></div>
                <div><dt>@Localizer["PaymentStatus"]</dt><dd>@(Model.IsPaid ? Localizer["Paid"] : Localizer["Unpaid"])</dd></div>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div><dt>@Localizer["OrderNote"]</dt><dd>@Model.Note</dd></div>
                }
                @if (string.Equals(Model.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)
                     && !string.IsNullOrWhiteSpace(Model.CancelReason))
                {
                    <div><dt>@Localizer["CancellationReason"]</dt><dd>@Model.CancelReason @Model.CancelReasonDetail</dd></div>
                }
            </dl>
            <div class="order-detail-total">
                <span>@Localizer["GrandTotal"]</span>
                <strong>@Model.TotalAmount.ToString("N0", vi) ₫</strong>
            </div>
        </aside>
    </div>
</main>

@section Scripts {
    <script>
        document.querySelectorAll('.order-cancel-form').forEach(form => {
            const reason = form.querySelector('select[name="cancelReason"]');
            const detail = form.querySelector('textarea[name="cancelReasonDetail"]');
            reason.addEventListener('change', () => {
                const isOther = reason.value === 'Other';
                detail.hidden = !isOther;
                detail.required = isOther;
                if (!isOther) detail.value = '';
            });
        });
    </script>
}
