@using System.Globalization
@using Microsoft.Extensions.Localization
@model ShopView.ViewModels.CartViewModel
@inject IStringLocalizer<ShopView.SharedResource> Localizer

@{
    Layout = "_MyLayout";
    ViewData["Title"] = Localizer["MyCart"];
    ViewData["PageClass"] = "cart-context";

    var imageBaseUrl = "https://localhost:7130/";
    var items = Model?.CartItems ?? new List<ShopView.ViewModels.CartItemViewModel>();
    var grandTotal = items.Sum(item => (item.Price ?? 0m) * item.Quantity);
    var moneyCulture = CultureInfo.GetCultureInfo("vi-VN");
}

@section Styles {
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

<main class="cart-page container">
    <header class="cart-page-header">
        <div>
            <h1>@Localizer["MyShoppingCart"]</h1>
            <p>@Localizer["ReviewCart"]</p>
        </div>
        @if (items.Count > 0)
        {
            <span class="cart-count">@items.Count @Localizer["CartItemsLabel"]</span>
        }
    </header>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="cart-alert cart-alert-error" role="alert">@TempData["ErrorMessage"]</div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cart-alert cart-alert-success" role="status">@TempData["SuccessMessage"]</div>
    }

    @if (items.Count == 0)
    {
        <section class="cart-empty" aria-labelledby="cart-empty-title">
            <span class="cart-empty-icon" aria-hidden="true"><i class="fa fa-shopping-basket"></i></span>
            <h2 id="cart-empty-title">@Localizer["EmptyCart"]</h2>
            <p>@Localizer["AddFoodComboNow"]</p>
            <a asp-controller="Food" asp-action="Index" class="cart-primary-action">
                @Localizer["ContinueShopping"] <i class="fa fa-arrow-right" aria-hidden="true"></i>
            </a>
        </section>
    }
    else
    {
        <div class="cart-layout">
            <section class="cart-products" aria-labelledby="cart-products-title">
                <div class="cart-panel-heading">
                    <h2 id="cart-products-title">@Localizer["Product"]</h2>
                    <span>@items.Count</span>
                </div>

                @foreach (var item in items)
                {
                    var isFood = item.FoodItemID.HasValue;
                    var type = isFood ? Localizer["Food"] : Localizer["Combo"];
                    var name = (isFood ? item.FoodItem?.Name : item.Combo?.Name) ?? type.Value;
                    var imagePath = isFood ? item.FoodItem?.ImagePath : item.Combo?.ImagePath;
                    var imageUrl = string.IsNullOrWhiteSpace(imagePath)
                        ? null
                        : imageBaseUrl.TrimEnd('/') + "/" + imagePath.TrimStart('/');
                    var price = item.Price ?? 0m;
                    var lineTotal = price * item.Quantity;

                    <article class="cart-item">
                        <div class="cart-item-media">
                            @if (imageUrl != null)
                            {
                                <img src="@imageUrl" alt="@name" loading="lazy" />
                            }
                            else
                            {
                                <i class="fa fa-utensils" aria-hidden="true"></i>
                            }
                        </div>

                        <div class="cart-item-info">
                            <span class="cart-item-type">@type</span>
                            <h3>@name</h3>
                            <p>@Localizer["Price"]: <strong>@price.ToString("N0", moneyCulture) ₫</strong></p>
                        </div>

                        <div class="cart-item-actions">
                            <form asp-controller="Cart" asp-action="Update" method="post" class="cart-quantity-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <label for="quantity-@item.CartItemId">@Localizer["Quantity"]</label>
                                <input id="quantity-@item.CartItemId" type="number" name="quantity"
                                       value="@item.Quantity" min="1" step="1" required inputmode="numeric" />
                                <button type="submit">@Localizer["Update"]</button>
                            </form>

                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <button type="submit" class="cart-remove">
                                    <i class="fa fa-trash-alt" aria-hidden="true"></i> @Localizer["Remove"]
                                </button>
                            </form>
                        </div>

                        <div class="cart-item-total">
                            <span>@Localizer["Subtotal"]</span>
                            <strong>@lineTotal.ToString("N0", moneyCulture) ₫</strong>
                        </div>
                    </article>
                }
            </section>

            <aside class="cart-summary" aria-labelledby="cart-summary-title">
                <h2 id="cart-summary-title">@Localizer["CartSummary"]</h2>
                <div class="cart-summary-row">
                    <span>@Localizer["TotalItems"]</span>
                    <strong>@items.Count</strong>
                </div>
                <div class="cart-summary-row">
                    <span>@Localizer["Subtotal"]</span>
                    <strong>@grandTotal.ToString("N0", moneyCulture) ₫</strong>
                </div>
                <div class="cart-summary-total">
                    <span>@Localizer["GrandTotal"]</span>
                    <strong>@grandTotal.ToString("N0", moneyCulture) ₫</strong>
                </div>
                <a asp-controller="Order" asp-action="Checkout" class="cart-primary-action cart-checkout">
                    @Localizer["ProceedCheckout"] <i class="fa fa-arrow-right" aria-hidden="true"></i>
                </a>
                <a asp-controller="Food" asp-action="Index" class="cart-continue">
                    <i class="fa fa-arrow-left" aria-hidden="true"></i> @Localizer["ContinueShopping"]
                </a>
            </aside>
        </div>
    }
</main>
